#!/usr/bin/env cargo +nightly -Zscript --quiet
---
[package]
edition = "2024"
---

use std::{error, fs, process::Command};

fn main() -> Result<(), Box<dyn error::Error>> {
    println!("Updating last_modified...");

    let status = Command::new("git")
        .args(["status", "--porcelain"])
        .output()?;

    let lines = str::from_utf8(&status.stdout)?.lines();

    for l in lines {
        if l.ends_with(".md") || l.ends_with(".mdx") {
            let Some(file_name) = l.split_whitespace().last() else {
                eprintln!("could not parse file_name for {l}");
                continue;
            };

            let last_modified = Command::new("git")
                .args(["log", "-1"])
                .args(["--pretty=format:%aI", "--"])
                .arg(file_name)
                .output()?
                .stdout;

            let last_modified = str::from_utf8(&last_modified)?.trim();
            let content = fs::read_to_string(file_name)?;

            let Some(content) = content
                .strip_prefix("---\n")
                .and_then(|rest| rest.find("\n---\n").map(|idx| &rest[idx + 5..]))
            else {
                eprintln!("could not strip prefix for {file_name}");
                continue;
            };

            let content = format!("---\nmodified: {last_modified}\n---\n{}", content);
            fs::write(file_name, content)?;
            println!("{file_name} {last_modified}");
        }
    }

    println!("Done!");
    Ok(())
}

